# 服务
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/attendance
JWT_SECRET=change_this_secret

# 仓储送货单 OCR（阿里云百炼 / DashScope OpenAI 兼容）
OCR_API_KEY=sk-your-dashscope-api-key
# 默认用 qwen-vl-plus（约 3–15s）。qwen3.7-plus 更准但常 45–60s，易触发前端 upload 超时
OCR_MODEL=qwen-vl-plus
OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 服务端 OCR 超时（毫秒），建议小于前端 uploadFile timeout
OCR_TIMEOUT_MS=50000

# 本地联调可设 OCR_MOCK=1，跳过外部 API，返回固定示例 JSON
# OCR_MOCK=1
